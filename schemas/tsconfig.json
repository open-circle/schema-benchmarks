{
  "extends": "../tsconfig.base.json",
  "include": ["libraries/**/*", "src/**/*", "test/**/*", "scripts/**/*"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "#src": ["./src/index.ts"]
    },
    "types": ["node", "vite-plus/pack/client"],
    "declaration": true,
    "declarationMap": true
  }
}
