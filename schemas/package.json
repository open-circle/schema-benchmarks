{
  "name": "@schema-benchmarks/schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./libraries": "./dist/index.mjs"
  },
  "scripts": {
    "gen:paseri": "node ./libraries/@paseri/compiler/generate.ts",
    "gen:zod-compiler": "node ./libraries/zod-compiler/generate.ts",
    "prebuild": "pnpm run gen:paseri && pnpm run gen:zod-compiler",
    "postbuild": "pnpm run gen:json-schemas",
    "gen:json-schemas": "node ./scripts/gen-accepted-json-schemas.ts",
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest"
  },
  "dependencies": {
    "@ark/json-schema": "^0.0.7",
    "@ata-project/keywords": "^0.1.14",
    "@cfworker/json-schema": "^4.1.1",
    "@paseri/compiler": "jsr:^0.7.7",
    "@paseri/paseri": "jsr:^1.9.7",
    "@railway-ts/pipelines": "^0.1.29",
    "@remix-run/data-schema": "^0.3.0",
    "@sapphire/shapeshift": "^5.0.0",
    "@schema-benchmarks/json-schema-tests": "workspace:*",
    "@schema-benchmarks/utils": "workspace:*",
    "@standard-schema/spec": "catalog:",
    "@valibot/to-json-schema": "^1.7.1",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "arktype": "^2.2.3",
    "ata-validator": "^1.9.0",
    "decoders": "^2.9.3",
    "dedent": "catalog:",
    "effect": "^3.22.0",
    "effect___beta": "npm:effect@4.0.0-beta.101",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "io-ts-types": "^0.5.19",
    "joi": "^18.2.5",
    "joi-to-json": "^5.0.5",
    "jsonschema": "^1.5.0",
    "mutative": "catalog:",
    "runtypes": "^7.0.5",
    "superstruct": "^2.0.2",
    "sury": "11.0.0-rc.2",
    "typebox": "catalog:",
    "typia": "^14.0.4",
    "valibot": "catalog:",
    "yup": "^1.7.1",
    "z-schema": "^12.4.4",
    "zod": "^4.5.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@ttsc/unplugin": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "^0.22.14",
    "ttsc": "catalog:",
    "typescript": "catalog:",
    "unplugin-macros": "^0.23.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod-compiler": "^1.28.0"
  }
