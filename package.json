{
  "name": "schema-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vpr -r test",
    "coverage": "vpr -r coverage",
    "typecheck": "vpr -r typecheck",
    "website:dev": "vpr --filter website dev",
    "website:build": "vpr --filter website build",
    "website:serve": "vpr --filter website serve",
    "website:storybook": "vpr --filter website storybook",
    "bench:bench": "vpr --filter @schema-benchmarks/bench bench",
    "bench:json-schema": "vpr --filter @schema-benchmarks/bench json-schema",
    "bench:stack": "vpr --filter @schema-benchmarks/bench stack",
    "bench:types": "vpr --filter @schema-benchmarks/bench types",
    "json-schema-tests:checkout": "vpr --filter json-schema-tests checkout",
    "json-schema-tests:bump": "vpr --filter json-schema-tests bump:test-suite-commit",
    "postinstall": "vp config --no-agent",
    "knip": "knip",
    "e2e": "vpr -r e2e"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "catalog:",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-playwright": "^2.12.0",
    "knip": "^6.39.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.28.3"
}
