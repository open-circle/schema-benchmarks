{
  "name": "@schema-benchmarks/json-schema-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*",
    "#remotes/*": "./remotes/*",
    "#constants/*": "./constants/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./remotes": "./constants/remotes.gen.ts",
    "./tests/*.json": "./tests/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "postinstall": "vpr checkout",
    "bump:test-suite-commit": "node ./scripts/bump-test-suite-commit.ts",
    "postbump:test-suite-commit": "vpr checkout",
    "test": "vp test",
    "coverage": "vp test run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@schema-benchmarks/utils": "workspace:",
    "@vitest/coverage-v8": "catalog:",
    "dedent": "catalog:",
    "del-cli": "^7.0.0",
    "tar": "^7.5.22",
    "typescript": "catalog:",
    "up-fetch": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
