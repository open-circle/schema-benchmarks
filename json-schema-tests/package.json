{
  "name": "@schema-benchmarks/json-schema-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tests/*.json": "./tests/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "checkout": "del-cli tests && degit github:json-schema-org/json-schema-test-suite/tests tests && del-cli tests/latest",
    "typecheck": "tsc --noEmit",
    "gen-constants": "node ./scripts/gen-constants.ts"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@schema-benchmarks/utils": "workspace:",
    "degit": "^3.6.5",
    "del-cli": "^7.0.0",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  }
}
