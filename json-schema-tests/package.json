{
  "name": "@schema-benchmarks/json-schema-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*",
    "#constants/*": "./constants/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tests/*.json": "./tests/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "postinstall": "pnpm checkout",
    "precheckout": "del-cli tests",
    "checkout": "node ./scripts/checkout.ts",
    "postcheckout": "node ./scripts/gen-constants.ts",
    "bump:test-suite-commit": "node ./scripts/bump-test-suite-commit.ts",
    "postbump:test-suite-commit": "pnpm checkout",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@schema-benchmarks/utils": "workspace:",
    "del-cli": "^7.0.0",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "up-fetch": "catalog:"
  }
}
