{
  "name": "@schema-benchmarks/website",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*",
    "#storybook/*": "./.storybook/*",
    "#e2e/*": "./e2e/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 3000",
    "serve": "node preview.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "typecheck": "tsc",
    "copy-results": "cp ../bench/bench.json ../bench/download.json ../bench/json-schema.json ../bench/stack.json ./public/",
    "gen-offline": "node offline/generate.ts",
    "e2e:gen-versions": "node ./e2e/scripts/gen-library-versions.ts",
    "prebuild": "pnpm copy-results",
    "predev": "pnpm copy-results",
    "postbuild": "pnpm gen-offline",
    "pree2e": "pnpm run e2e:gen-versions",
    "e2e": "playwright test"
  },
